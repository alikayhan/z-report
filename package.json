{
  "name": "z-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "mod:types": "node packaging/claude-code-mod/generate-types.mjs",
    "mod:typecheck": "npm run mod:types && tsc -p mods/claude-code/tsconfig.json",
    "mod:check": "npm run mod:typecheck && CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 claude plugin test mods/claude-code",
    "mod:test": "cargo test --locked -p z-report-core && cargo build --locked -p z-report-cli && python3 crates/z-report-cli/tests/integration.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.273",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
