{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z Report",
  "version": "0.1.0",
  "identifier": "com.alikayhan.zreport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Z Report",
        "width": 1200,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RDdBRTFFMDRGNzFFOUIKUldTYkh2Y0VIcTdYZWZLVGozWmVVcmdrOVpCZ3hmNWMrQVhFa2JTS3U1Y1JmbG5mcC9ZMktIZkwK",
      "endpoints": [
        "https://github.com/alikayhan/z-report-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
